# WAP to create a project where we are supposed to create a detector.
# It will detect the temperature based on the hand symbol.
# If the user is pointing a thumbs up on the screen the temperature rises.
# If the user is pointing a thumbs down the temperature decreases.

import cv2
import mediapipe as mp


# Initialize video capture
cap = cv2.VideoCapture(0)

# Initialize MediaPipe Hands
mp_hands = mp.solutions.hands
hands = mp_hands.Hands(
    max_num_hands=1,
    min_detection_confidence=0.7,
    min_tracking_confidence=0.7,
)

draw = mp.solutions.drawing_utils

# Temperature settings
temperature = 25.0
min_temp = 20.0
max_temp = 100.0


while True:
    success, frame = cap.read()
    if not success:
        print("Failed to access the camera.")
        break

    frame = cv2.flip(frame, 1)
    rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    results = hands.process(rgb_frame)

    gesture = "No Hand Detected"

    if results.multi_hand_landmarks:
        for hand_landmarks in results.multi_hand_landmarks:
            draw.draw_landmarks(
                frame,
                hand_landmarks,
                mp_hands.HAND_CONNECTIONS,
                draw_spec=draw.DrawingSpec(color=(0, 255, 0), thickness=2, circle_radius=3),
                landmark_drawing_spec=draw.DrawingSpec(color=(255, 0, 0), thickness=2, circle_radius=2),
            )

            thumb_tip = hand_landmarks.landmark[4]
            thumb_ip = hand_landmarks.landmark[3]
            thumb_mcp = hand_landmarks.landmark[2]

            # Detect thumb direction
            # If thumb tip is above the thumb IP joint => thumbs up
            # If thumb tip is below the thumb IP joint => thumbs down
            if thumb_tip.y < thumb_ip.y and abs(thumb_tip.x - thumb_mcp.x) > 0.05:
                gesture = "Thumbs Up"
                temperature = min(max_temp, temperature + 0.5)
            elif thumb_tip.y > thumb_ip.y and abs(thumb_tip.x - thumb_mcp.x) > 0.05:
                gesture = "Thumbs Down"
                temperature = max(min_temp, temperature - 0.5)
            else:
                gesture = "Hand Detected"

    # Display temperature bar
    bar_x = 30
    bar_y = 60
    bar_w = 300
    bar_h = 30
    fill_width = int(((temperature - min_temp) / (max_temp - min_temp)) * bar_w)

    cv2.rectangle(frame, (bar_x, bar_y), (bar_x + bar_w, bar_y + bar_h), (255, 255, 255), 2)
    cv2.rectangle(frame, (bar_x, bar_y), (bar_x + fill_width, bar_y + bar_h), (0, 0, 255), -1)

    cv2.putText(
        frame,
        f"Temperature: {temperature:.1f} C",
        (bar_x, 45),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.8,
        (0, 255, 255),
        2,
    )

    cv2.putText(
        frame,
        gesture,
        (bar_x, 110),
        cv2.FONT_HERSHEY_SIMPLEX,
        1.0,
        (0, 255, 0),
        2,
    )

    cv2.imshow("Thumb Temperature Detector", frame)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()

